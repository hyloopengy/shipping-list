POSTGRES_DB=packing
POSTGRES_USER=packing
POSTGRES_PASSWORD=请生成至少32位随机密码
SECRET_KEY=请生成至少64位随机密钥
SERVER_ADDRESS=服务器公网IP或域名
BASIC_AUTH_USER=shipping
# 使用 `docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '你的网页密码'` 生成。
# bcrypt 值含有 $，必须用单引号包住，且这里只保存哈希，不填写网页明文密码。
BASIC_AUTH_HASH='$2a$14$请替换为生成的完整密码哈希'
HTTP_PORT=80
HTTPS_PORT=443
APP_BIND=127.0.0.1
APP_PORT=8080
COOKIE_SECURE=1

# Docker Hub 不可达时，可设置为可信镜像代理或内部镜像仓库地址。
# PYTHON_IMAGE=镜像地址/python:3.12-slim
# POSTGRES_IMAGE=镜像地址/postgres:16-alpine
# CADDY_IMAGE=镜像地址/caddy:2.10-alpine
